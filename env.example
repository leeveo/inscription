# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Email Configuration (Optional)
MAILERSEND_API_KEY=your_mailersend_api_key_here
BREVO_API_KEY=your_brevo_api_key_here

# Stripe Configuration (Optional - for billing features)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# Upload Configuration (Optional)
UPLOADTHING_SECRET=your_uploadthing_secret_here
UPLOADTHING_APP_ID=your_uploadthing_app_id_here

# Instructions:
# 1. Copy this file to .env.local
# 2. Fill in your actual Supabase credentials from https://supabase.com/dashboard/project/_/settings/api
# 3. Add other API keys as needed for additional features